{
  "manifest_version": 3,
  "name": "Visio Keyword Alert",
  "version": "0.2.0",
  "description": "Surveille une fenêtre de visioconférence, transcrit l'audio, détecte un mot-clé, alerte et ouvre un chat Gemini avec la dernière question et une capture.",
  "permissions": [
    "storage",
    "notifications",
    "windows"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Visio Keyword Alert"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
